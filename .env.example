# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=moksha
POSTGRES_USER=moksha_user
POSTGRES_PASSWORD=generate-with-scripts/generate_runtime_secrets.ps1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=moksha-qwen3:4b-instruct-q3km

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Direct local Nuxt access (Caddy handles this route in deployment)
NUXT_API_PROXY=http://127.0.0.1:8000

# Background jobs
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
MOKSHA_METRICS_TOKEN=generate-with-scripts/generate_runtime_secrets.ps1
MOKSHA_BYOK_KEYRING_HOST_FILE=./deploy/runtime-secrets/byok-keyring.json
JOB_STALE_MINUTES=20
DISK_MIN_FREE_BYTES=5368709120
MODEL_PART_MAX_AGE_HOURS=24

# RAG controls
RAG_MIN_SIMILARITY=0.35
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_MAX_CONCURRENT_REQUESTS=1
OLLAMA_IMPORTS_DIR=D:/Softwares/Ollama/Imports
MODEL_MIN_TOKENS_PER_SECOND=20
MODEL_MAX_VRAM_BYTES=4294967296
